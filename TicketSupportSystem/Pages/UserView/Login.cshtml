@page
@model TicketSupportSystem.Pages.UserView.LoginModel
<h1>Login</h1>
<form method="post">
  <div class="mb-3">
    <label asp-for="Email" class="form-label">Email </label>
    <input asp-for="Email" />
    <span asp-validation-for="Email" class="text-danger"></span>
    </div>
  <div class="mb-3">
    <label asp-for="Password" class="form-label">Password </label>
    <input asp-for="Password" />
    <span asp-validation-for="Password" class="text-danger"></span>
  </div>
  <button type="submit" class="btn btn-primary">Log In</button>
  <input type="checkbox" asp-for="RemainSignedIn" class="form-check-input" />
  <label asp-for="RemainSignedIn" class="form-check-label">Remain Signed In</label>
</form>
<a asp-page="ForgotPassword">Forgotten your password?</a>
<a asp-page="Register">Create an account</a>