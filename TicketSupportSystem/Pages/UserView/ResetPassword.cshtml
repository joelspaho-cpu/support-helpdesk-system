@page
@model TicketSupportSystem.Pages.UserView.ResetPasswordModel
<h1>Reset your password</h1>
<form method="post">
 <div class="mb-3">
    <label asp-for="NewPassword" class="form-label">New Password </label>
    <input asp-for="NewPassword" />
    <span asp-validation-for="NewPassword" class="text-danger"></span>
    <label asp-for="ConfirmNewPassword" class="form-label">Confirm Password </label>
    <input asp-for="ConfirmNewPassword" />
    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
</div>
<button type="submit" class="btn btn-primary">Save Changes</button>
</form>
<p>Please ensure your password is at least 8 characters long, includes an upper case, a lower case character and a number</p>

